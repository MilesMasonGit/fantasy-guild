{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/tests/**/*.test.{js,jsx}",
    "src/tests/setup/*.js",
    "bench/*.mjs",
    "bench/micro/**/*.{js,mjs}",
    "scripts/*.mjs",
    "scripts/*.js",
    "tools/*.mjs"
  ],
  "project": ["src/**/*.{js,jsx}", "bench/**/*.{js,mjs}", "scripts/**/*.{js,mjs}", "tools/**/*.mjs"],
  "ignore": ["cms/**"],
  "ignoreDependencies": ["@fontsource/*", "tailwindcss"],
  "ignoreExportsUsedInFile": true
}
